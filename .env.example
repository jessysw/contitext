# Prefer scripts/bootstrap.py, which generates unique secrets and identity IDs.
POSTGRES_USER=contitext
POSTGRES_DB=contitext
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://contitext:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/contitext
CONTITEXT_PORT=18791
CONTITEXT_AUTH_TOKENS='{"REPLACE_WITH_RANDOM_TOKEN":{"principal_id":"11111111-1111-4111-8111-111111111111","name":"Example developer"}}'
CONTITEXT_MCP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
CONTITEXT_SEED_JSON='{"projects":[{"id":"demo","display_name":"Demo project","status":"active"}],"principals":[{"id":"11111111-1111-4111-8111-111111111111","name":"Example developer"}],"acls":[{"project_id":"demo","principal_id":"11111111-1111-4111-8111-111111111111","role":"owner"}]}'
CONTITEXT_SMOKE_PROJECT_ID=demo
# Optional reader bind-mount ownership; bootstrap fills these from the host.
CONTITEXT_READER_UID=10001
CONTITEXT_READER_GID=10001
